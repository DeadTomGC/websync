# websync environment variables
# Copy to .env for local development (never commit .env).
# In GitLab CI, set these as CI/CD variables.

# --- Cameo Teamwork Cloud ---
CAMEO_TWC_BASE_URL=https://cameo.internal.example.com:8443/twc/v1
CAMEO_TWC_USER=
CAMEO_TWC_PASSWORD=
# Staging instances with self-signed certs only; logs a loud warning if set.
CAMEO_TWC_INSECURE_SKIP_VERIFY=false

# --- Jama ---
JAMA_BASE_URL=https://jama.internal.example.com
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=

# --- Jira ---
JIRA_BASE_URL=https://jira.internal.example.com
JIRA_USER=
JIRA_TOKEN=

# --- Sync state ---
# Where the SQLite state database lives (CI cache/artifact mount).
WEBSYNC_DB_PATH=state.db
