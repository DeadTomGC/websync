# websync environment variables
# Copy to .env for local development (never commit .env).
# In GitLab CI, set these as CI/CD variables.

# --- Cameo Teamwork Cloud (via the atwc package) ---
# TWC REST API root; atwc authenticates against {base}/login and {base}/logout.
CAMEO_TWC_BASE_URL=https://twc.internal.example.com:8111/osmc/
CAMEO_TWC_USER=
CAMEO_TWC_PASSWORD=
# Per-request timeout seconds (default 30).
CAMEO_TWC_TIMEOUT=30
# Staging instances with self-signed certs only; never enable in production.
CAMEO_TWC_INSECURE_SKIP_VERIFY=false

# --- Jama ---
JAMA_BASE_URL=https://jama.internal.example.com
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=
JAMA_TIMEOUT=30
JAMA_INSECURE_SKIP_VERIFY=false

# --- Jira ---
JIRA_BASE_URL=https://jira.internal.example.com
JIRA_USER=
JIRA_TOKEN=

# --- Live adapter checks (pytest -m live; scratch projects only!) ---
CAMEO_TWC_LIVE_PROJECT=
JAMA_LIVE_PROJECT=

# --- Sync state ---
# Where the SQLite state database lives (CI cache/artifact mount).
WEBSYNC_DB_PATH=state.db
